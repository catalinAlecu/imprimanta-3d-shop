<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coșul meu - Imprimante 3D Shop</title>
    <link rel="icon" type="image/png" href="/images/favicon1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=<%= Date.now() %>">
</head>
<body class="bg-dark-theme text-white">

    <%- include('partials/navbar') %>

    <main class="container pt-5 mt-5 cart-main">
        <h2 class="fw-bold mb-4">Coșul tău de cumpărături</h2>

        <% if (items && items.length > 0) { %>
            <% const totalProduse = items.reduce((acc, el) => acc + el.quantity, 0); %>

            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <div class="d-flex flex-column gap-3">
                        <% items.forEach(function(cartItem) { %>
                            <article class="cart-item-card p-3 p-md-4">
                                <div class="row g-3 align-items-center">
                                    <!-- Imagine produs -->
                                    <div class="col-sm-3">
                                        <a href="/imprimanta/<%= cartItem.item._id %>" class="cart-img-wrapper d-flex align-items-center justify-content-center">
                                            <% if (cartItem.item.imagine && typeof cloudName !== 'undefined' && cloudName) { %>
                                                <img
                                                    src="https://res.cloudinary.com/<%= cloudName %>/image/upload/<%= cartItem.item.imagine %>"
                                                    alt="<%= cartItem.item.marca %> <%= cartItem.item.model %>"
                                                    class="cart-item-img"
                                                >
                                            <% } else { %>
                                                <img
                                                    src="/images/default.jpg"
                                                    alt="<%= cartItem.item.marca %> <%= cartItem.item.model %>"
                                                    class="cart-item-img"
                                                >
                                            <% } %>
                                        </a>
                                    </div>

                                    <!-- Detalii produs -->
                                    <div class="col-sm-6">
                                        <div class="d-flex flex-wrap gap-2 mb-2">
                                            <% if (cartItem.item.tehnologie) { %>
                                                <span class="badge bg-info text-dark"><%= cartItem.item.tehnologie %></span>
                                            <% } %>
                                            <% if (cartItem.item.stare) { %>
                                                <span class="badge bg-secondary"><%= cartItem.item.stare %></span>
                                            <% } %>
                                        </div>

                                        <h5 class="mb-1 fw-semibold">
                                            <a href="/imprimanta/<%= cartItem.item._id %>" class="cart-product-link">
                                                <%= cartItem.item.marca %> <%= cartItem.item.model %>
                                            </a>
                                        </h5>

                                        <% if (cartItem.item.descriere) { %>
                                            <p class="cart-product-desc mb-2"><%= cartItem.item.descriere %></p>
                                        <% } %>

                                        <div class="cart-meta-info">
                                            Preț unitar: <span><%= cartItem.item.pret %> RON</span>
                                        </div>
                                    </div>

                                    <!-- Cantitate, subtotal și ștergere -->
                                    <div class="col-sm-3 d-flex flex-sm-column justify-content-between align-items-center align-items-sm-end gap-2 text-sm-end">
                                        <div class="d-flex flex-column align-items-center align-items-sm-end">
                                            <div class="cart-qty-control d-inline-flex align-items-center mb-2">
                                                <form action="/cart/update/<%= cartItem.item._id %>/decrease" method="POST" class="m-0 p-0">
                                                    <button type="submit" class="cart-qty-btn" aria-label="Scade cantitatea">-</button>
                                                </form>

                                                <span class="cart-qty-value"><%= cartItem.quantity %></span>

                                                <form action="/cart/update/<%= cartItem.item._id %>/increase" method="POST" class="m-0 p-0">
                                                    <button type="submit" class="cart-qty-btn" aria-label="Crește cantitatea">+</button>
                                                </form>
                                            </div>

                                            <div class="cart-subtotal">
                                                <%= cartItem.item.pret * cartItem.quantity %> RON
                                            </div>
                                        </div>

                                        <form action="/cart/remove/<%= cartItem.item._id %>" method="POST" class="m-0 p-0">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Șterge
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                </div>

                <!-- DREAPTA (4 coloane): Sumarul comenzii -->
                <aside class="col-lg-4">
                    <div class="cart-summary-card p-4">
                        <h4 class="fw-bold mb-4">Sumar comandă</h4>

                        <div class="d-flex justify-content-between mb-2 cart-summary-row">
                            <span>Produse (<%= totalProduse %>)</span>
                            <span><%= totalAmount %> RON</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3 cart-summary-row">
                            <span>Livrare</span>
                            <span class="text-info">La pasul următor</span>
                        </div>

                        <hr class="cart-divider">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-semibold">Total</span>
                            <span class="cart-total-price"><%= totalAmount %> RON</span>
                        </div>

                        <a href="/checkout" class="btn btn-success btn-lg fw-bold w-100 mb-2">
                            Mergi la Checkout
                        </a>
                        <a href="/models" class="btn btn-outline-light btn-sm w-100">
                            Continuă cumpărăturile
                        </a>
                    </div>
                </aside>
            </div>

        <% } else { %>
            <div class="cart-empty-card p-5 text-center">
                <p class="text-white-50 fs-5 mb-4">
                    Coșul tău este momentan gol. Aici vor fi afișate imprimantele selectate.
                </p>
                <a href="/models" class="btn btn-info fw-bold">Vezi Imprimantele 3D</a>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer', { fixedFooter: true }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>