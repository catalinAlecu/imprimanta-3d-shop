<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modele Imprimante 3D</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-dark text-light">

    <%- include('partials/navbar') %>

    <div class="container models-container">
        <h1 class="text-center mb-5 fw-bold text-accent">Echipamente Disponibile</h1>
        
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            
            <% if (imprimante && imprimante.length > 0) { %>
                
                <% imprimante.forEach(function(imprimanta) { %>
                    <div class="col">
                        <div class="card h-100 bg-secondary text-white border-0 shadow-lg printer-card">
                            
                            <img src="<%= imprimanta.imagine || '/images/default.jpg' %>" class="card-img-top printer-card-img" alt="<%= imprimanta.model %>">
                            
                            <div class="card-body d-flex flex-column">
                                <h4 class="card-title fw-bold mb-3">
                                    <%= imprimanta.marca %> <%= imprimanta.model %>
                                </h4>
                                
                                <div class="mb-3">
                                    <span class="badge bg-info text-dark me-2 px-3 py-2"><%= imprimanta.tehnologie %></span>
                                    <span class="badge bg-dark border border-light px-3 py-2"><%= imprimanta.stare %></span>
                                </div>
                                
                                <p class="card-text text-light opacity-75 mb-4 printer-desc">
                                    <%= imprimanta.descriere %>
                                </p>
                                
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <h3 class="fw-bold mb-0 text-accent">
                                        <%= imprimanta.pret %> <span class="currency-text">RON</span>
                                    </h3>
                                    <button class="btn btn-outline-light rounded-pill px-4">Adaugă în coș</button>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                <% }) %>

            <% } else { %>
                <div class="col-12 text-center mt-5">
                    <h3 class="text-muted">Momentan nu avem echipamente în stoc.</h3>
                    <p class="text-secondary">Revino în curând pentru noutăți!</p>
                </div>
            <% } %>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>