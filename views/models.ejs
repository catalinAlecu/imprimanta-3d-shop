<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modele Imprimante 3D</title>
    <link rel="icon" type="image/png" href="/images/favicon1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=<%= Date.now() %>">
</head>
<body class="bg-dark text-light">

    <%- include('partials/navbar') %>

    <%
        const listaImprimante = Array.isArray(imprimante) ? imprimante : [];
        const listaCategorii = typeof categorii !== 'undefined' && Array.isArray(categorii) ? categorii : [];
        const filtruText = typeof categorieSelectata !== 'undefined' ? categorieSelectata : '';
        const catActiva = typeof categorieActiva !== 'undefined' ? categorieActiva : null;
    %>

    <div class="container models-container">
        <h1 class="text-center mb-4 fw-bold text-accent">Echipamente Disponibile</h1>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <div class="d-flex flex-wrap gap-2">
                <a
                    href="/models"
                    class="btn btn-sm <%= !filtruText ? 'btn-info text-dark fw-bold' : 'btn-outline-light' %>"
                >
                    Toate modelele
                </a>

                <% listaCategorii.forEach(function(cat) { %>
                    <% const esteActiva = catActiva && catActiva._id.toString() === cat._id.toString(); %>
                    <a
                        href="/models?categorie=<%= encodeURIComponent(cat.name) %>"
                        class="btn btn-sm <%= esteActiva ? 'btn-info text-dark fw-bold' : 'btn-outline-light' %>"
                    >
                        <%= cat.name %>
                    </a>
                <% }) %>
            </div>

            <% if (catActiva) { %>
                <span class="text-secondary small">
                    Categorie: <strong class="text-info"><%= catActiva.name %></strong>
                    (<%= listaImprimante.length %> <%= listaImprimante.length === 1 ? 'produs' : 'produse' %>)
                </span>
            <% } else if (filtruText) { %>
                <span class="text-secondary small">
                    Filtru activ: <strong class="text-info"><%= filtruText %></strong>
                </span>
            <% } %>
        </div>

        <% if (listaImprimante.length > 0) { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <% listaImprimante.forEach(function(imprimanta) { %>
                    <div class="col">
                        <div class="card h-100 bg-secondary text-white border-0 shadow-lg printer-card">
                            <a href="/imprimanta/<%= imprimanta._id %>" class="stretched-link"></a>

                            <img
                                src="<%= imprimanta.imagine ? 'https://res.cloudinary.com/' + cloudName + '/image/upload/' + imprimanta.imagine : '/images/default.jpg' %>"
                                class="card-img-top printer-card-img"
                                alt="<%= imprimanta.marca %> <%= imprimanta.model %>"
                            >

                            <div class="card-body d-flex flex-column">
                                <h4 class="card-title fw-bold mb-3">
                                    <%= imprimanta.marca %> <%= imprimanta.model %>
                                </h4>

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge bg-info text-dark px-3 py-2"><%= imprimanta.tehnologie %></span>
                                    <span class="badge bg-dark border border-light px-3 py-2"><%= imprimanta.stare %></span>
                                    <% if (imprimanta.categorie && imprimanta.categorie.name) { %>
                                    <% } %>
                                </div>

                                <p class="card-text text-light opacity-75 mb-4 printer-desc">
                                    <%= imprimanta.descriere %>
                                </p>

                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <h3 class="fw-bold mb-0 text-accent">
                                        <%= imprimanta.pret %> <span class="currency-text">RON</span>
                                    </h3>

                                    <form action="/cart/add/<%= imprimanta._id %>" method="POST" class="m-0 p-0 position-relative z-3">
                                        <button type="submit" class="btn btn-outline-light rounded-pill px-4">
                                            Adaugă în coș
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5 mt-3">
                <% if (filtruText) { %>
                    <h4 class="text-white mb-2">Nu există încă imprimante în această categorie.</h4>
                    <p class="text-secondary mb-3">Încearcă o altă categorie sau vizualizează tot catalogul.</p>
                    <a href="/models" class="btn btn-info text-dark fw-semibold">
                        Vezi toate modelele
                    </a>
                <% } else { %>
                    <h4 class="text-white mb-2">Momentan nu avem echipamente în stoc.</h4>
                    <p class="text-secondary mb-0">Revino în curând pentru noutăți!</p>
                <% } %>
            </div>
        <% } %>
    </div>

    <%- include('partials/footer', { fixedFooter: true }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>