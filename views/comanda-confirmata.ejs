<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comandă Confirmată</title>
    <link rel="icon" type="image/png" href="/images/favicon1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=<%= Date.now() %>">
</head>
<body class="bg-dark-theme text-white">

    <%- include('partials/navbar') %>

    <main class="container pt-5 mt-5 checkout-main">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <section class="checkout-card checkout-success-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="badge bg-success px-3 py-2 mb-3">Comandă înregistrată</span>
                        <h2 class="fw-bold mb-2">Mulțumim pentru comandă!</h2>
                        <p class="checkout-subtitle mb-0">
                            Comanda ta <strong class="text-info">#<%= comanda._id.toString().slice(-6).toUpperCase() %></strong>
                            a fost trimisă către gestionar pentru verificare și pregătire.
                        </p>
                    </div>

                    <div class="checkout-confirm-box p-3 mb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="checkout-label mb-1">Status curent</div>
                                <span class="badge bg-warning text-dark"><%= comanda.status %></span>
                            </div>
                            <div class="col-md-6">
                                <div class="checkout-label mb-1">Total comandă</div>
                                <div class="checkout-total-price"><%= comanda.total %> RON</div>
                            </div>
                            <div class="col-12">
                                <div class="checkout-label mb-1">Adresă de livrare & contact</div>
                                <div class="text-white">
                                    <%= comanda.address.street %>, <%= comanda.address.city %>,
                                    jud. <%= comanda.address.county %>, <%= comanda.address.zipCode %>
                                    — Tel: <%= comanda.phone %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2">Produse comandate</h6>
                    <ul class="manager-items-list mb-4">
                        <% comanda.produse.forEach(function(prod) { %>
                            <li>
                                <%= prod.marca %> <%= prod.model %>
                                — <strong><%= prod.cantitate %> buc.</strong>
                                (<%= prod.pretUnitar * prod.cantitate %> RON)
                            </li>
                        <% }) %>
                    </ul>

                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="/models" class="btn btn-info text-dark fw-semibold">Continuă cumpărăturile</a>
                        <a href="/" class="btn btn-outline-light">Înapoi la pagina principală</a>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <%- include('partials/footer', { fixedFooter: true }) %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>