<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panou Gestionar — Comenzi Plasate</title>
    <link rel="icon" type="image/png" href="/images/favicon1.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=<%= Date.now() %>">
</head>
<body class="bg-dark-theme text-white d-flex flex-column min-vh-100">

    <%- include('partials/navbar') %>

    <%
        const listaComenzi = Array.isArray(comenzi) ? comenzi : [];
        const stats = typeof statistici !== 'undefined' ? statistici : {
            total: listaComenzi.length,
            inAsteptare: 0,
            inCursDeLivrare: 0,
            livrate: 0,
            valoareTotala: 0
        };
        const filtruCurent = typeof statusActiv !== 'undefined' ? statusActiv : 'toate';
        const cautareCurenta = typeof termenCautare !== 'undefined' ? termenCautare : '';
        const querySuffix = cautareCurenta ? '&q=' + encodeURIComponent(cautareCurenta) : '';
    %>

    <main class="container pt-5 mt-5 manager-main flex-grow-1">
        <!-- Antet panou -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h2 class="fw-bold mb-1">Panou Gestionar — Comenzi Plasate</h2>
                <p class="manager-subtitle mb-0">
                    Predă comenzile curierului și marchează-le ca livrate individual sau prin acțiuni în masă.
                </p>
            </div>
            <span class="badge bg-info text-dark fs-6 px-3 py-2">
                Gestionar: <%= user ? user.username : '' %>
            </span>
        </div>

        <!-- Indicatori rapizi (KPI) -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl">
                <div class="manager-kpi-card kpi-total p-3">
                    <div class="manager-kpi-label">Total comenzi</div>
                    <div class="manager-kpi-value"><%= stats.total %></div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="manager-kpi-card kpi-pending p-3">
                    <div class="manager-kpi-label">În așteptare</div>
                    <div class="manager-kpi-value text-warning"><%= stats.inAsteptare %></div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="manager-kpi-card kpi-verified p-3">
                    <div class="manager-kpi-label">În curs de livrare</div>
                    <div class="manager-kpi-value text-info"><%= stats.inCursDeLivrare %></div>
                </div>
            </div>
            <div class="col-6 col-md-6 col-xl">
                <div class="manager-kpi-card kpi-shipped p-3">
                    <div class="manager-kpi-label">Livrate</div>
                    <div class="manager-kpi-value text-success"><%= stats.livrate %></div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl">
                <div class="manager-kpi-card kpi-revenue p-3">
                    <div class="manager-kpi-label">Valoare totală</div>
                    <div class="manager-kpi-value manager-kpi-money"><%= stats.valoareTotala %> RON</div>
                </div>
            </div>
        </div>

        <!-- Bară de filtre după status + Căutare -->
        <section class="manager-toolbar p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex flex-wrap gap-2">
                <a
                    href="/gestionar/comenzi?status=toate<%= querySuffix %>"
                    class="btn btn-sm manager-filter-btn <%= filtruCurent === 'toate' ? 'active' : '' %>"
                >
                    Toate (<%= stats.total %>)
                </a>
                <a
                    href="/gestionar/comenzi?status=In%20asteptare<%= querySuffix %>"
                    class="btn btn-sm manager-filter-btn <%= filtruCurent === 'In asteptare' ? 'active' : '' %>"
                >
                    În așteptare (<%= stats.inAsteptare %>)
                </a>
                <a
                    href="/gestionar/comenzi?status=In%20curs%20de%20livrare<%= querySuffix %>"
                    class="btn btn-sm manager-filter-btn <%= filtruCurent === 'In curs de livrare' ? 'active' : '' %>"
                >
                    În curs de livrare (<%= stats.inCursDeLivrare %>)
                </a>
                <a
                    href="/gestionar/comenzi?status=Livrata<%= querySuffix %>"
                    class="btn btn-sm manager-filter-btn <%= filtruCurent === 'Livrata' ? 'active' : '' %>"
                >
                    Livrate (<%= stats.livrate %>)
                </a>
            </div>

            <form action="/gestionar/comenzi" method="GET" class="d-flex gap-2 manager-search-form">
                <input type="hidden" name="status" value="<%= filtruCurent %>">
                <input
                    type="text"
                    name="q"
                    value="<%= cautareCurenta %>"
                    class="form-control form-control-sm manager-search-input"
                    placeholder="Caută ID, client, telefon, oraș..."
                >
                <button type="submit" class="btn btn-sm btn-info text-dark fw-semibold">Caută</button>
                <% if (cautareCurenta || filtruCurent !== 'toate') { %>
                    <a href="/gestionar/comenzi" class="btn btn-sm btn-outline-light">Resetează</a>
                <% } %>
            </form>
        </section>

        <!-- Bară Mass Action -->
        <% if (listaComenzi.length > 0) { %>
            <section class="manager-toolbar mass-action-bar p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="form-check m-0">
                        <input
                            type="checkbox"
                            id="selectAllOrders"
                            class="form-check-input manager-checkbox"
                        >
                        <label class="form-check-label text-white fw-semibold" for="selectAllOrders">
                            Selectează toate (nelivrate)
                        </label>
                    </div>
                    <span id="selectedCountBadge" class="badge bg-secondary">0 selectate</span>
                </div>

                <form id="massActionForm" action="/gestionar/comenzi/mass-action" method="POST" class="d-flex flex-wrap gap-2 m-0">
                    <button
                        type="submit"
                        name="action"
                        value="in_livrare"
                        class="btn btn-sm btn-info text-dark fw-semibold mass-action-btn"
                        disabled
                    >
                        Marchează În curs de livrare
                    </button>
                    <button
                        type="submit"
                        name="action"
                        value="livrata"
                        class="btn btn-sm btn-success fw-semibold mass-action-btn"
                        disabled
                    >
                        Marchează Livrate
                    </button>
                </form>
            </section>
        <% } %>

        <!-- Lista comenzilor -->
        <% if (listaComenzi.length > 0) { %>
            <div class="d-flex flex-column gap-3">
                <% listaComenzi.forEach(function(comanda) { %>
                    <article class="manager-order-card p-4 <%= comanda.status === 'Livrata' ? 'order-shipped' : (comanda.status === 'In curs de livrare' ? 'order-in-transit' : '') %>">
                        <div class="row g-3 align-items-center">

                            <div class="col-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <input
                                        type="checkbox"
                                        form="massActionForm"
                                        name="orderIds"
                                        value="<%= comanda._id %>"
                                        class="form-check-input manager-checkbox order-checkbox m-0"
                                        <%= comanda.status === 'Livrata' ? 'disabled' : '' %>
                                        title="<%= comanda.status === 'Livrata' ? 'Comandă deja livrată' : 'Selectează pentru acțiune în masă' %>"
                                    >

                                    <span class="manager-order-id">
                                        #<%= comanda._id.toString().slice(-6).toUpperCase() %>
                                    </span>

                                    <% if (comanda.status === 'Livrata') { %>
                                        <span class="badge bg-success">Livrată</span>
                                    <% } else if (comanda.status === 'In curs de livrare') { %>
                                        <span class="badge bg-info text-dark">În curs de livrare</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">În așteptare</span>
                                    <% } %>
                                </div>

                                <div class="manager-meta">
                                    <strong>Client:</strong>
                                    <%= comanda.user ? comanda.user.username : 'Utilizator șters' %>
                                    <% if (comanda.user && comanda.user.email) { %>
                                        (<%= comanda.user.email %>)
                                    <% } %>
                                </div>

                                <% if (comanda.phone) { %>
                                    <div class="manager-meta">
                                        <strong>Telefon:</strong> <%= comanda.phone %>
                                    </div>
                                <% } %>

                                <% if (comanda.address) { %>
                                    <div class="manager-meta">
                                        <strong>Adresă:</strong>
                                        <%= comanda.address.street %>, <%= comanda.address.city %>,
                                        jud. <%= comanda.address.county %>, <%= comanda.address.zipCode %>
                                    </div>
                                <% } %>

                                <% if (comanda.createdAt) { %>
                                    <div class="manager-date mt-1">
                                        Plasată la: <%= new Date(comanda.createdAt).toLocaleString('ro-RO') %>
                                    </div>
                                <% } %>
                            </div>

                            <div class="col-lg-4">
                                <div class="manager-section-label mb-1">Produse comandate:</div>
                                <ul class="manager-items-list mb-0">
                                    <% if (comanda.produse && comanda.produse.length > 0) { %>
                                        <% comanda.produse.forEach(function(prod) { %>
                                            <li>
                                                <%= prod.marca %> <%= prod.model %>
                                                — <strong><%= prod.cantitate %> buc.</strong>
                                                (<%= prod.pretUnitar * prod.cantitate %> RON)
                                            </li>
                                        <% }) %>
                                    <% } else { %>
                                        <li>Fără produse înregistrate</li>
                                    <% } %>
                                </ul>
                            </div>

                            <div class="col-lg-4 d-flex flex-column align-items-lg-end gap-2">
                                <div class="manager-order-total">
                                    Total: <span><%= comanda.total %> RON</span>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <% if (comanda.status === 'In asteptare') { %>
                                        <form action="/gestionar/comenzi/<%= comanda._id %>/in-livrare" method="POST" class="m-0 p-0">
                                            <button type="submit" class="btn btn-sm btn-outline-info fw-semibold">
                                                În curs de livrare
                                            </button>
                                        </form>
                                    <% } else if (comanda.status === 'In curs de livrare') { %>
                                        <button type="button" class="btn btn-sm btn-info text-dark fw-semibold" disabled>
                                            În curs de livrare
                                        </button>
                                    <% } %>

                                    <form action="/gestionar/comenzi/<%= comanda._id %>/livrata" method="POST" class="m-0 p-0">
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-success fw-semibold"
                                            <%= comanda.status === 'Livrata' ? 'disabled' : '' %>
                                        >
                                            <%= comanda.status === 'Livrata' ? '✓ Livrată' : 'Marchează Livrată' %>
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="manager-order-card p-5 text-center">
                <% if (cautareCurenta || filtruCurent !== 'toate') { %>
                    <h5 class="mb-2">Nicio comandă nu corespunde filtrului curent</h5>
                    <p class="manager-subtitle mb-3">
                        Încearcă un alt termen de căutare sau revino la toate comenzile.
                    </p>
                    <a href="/gestionar/comenzi" class="btn btn-sm btn-info text-dark fw-semibold">
                        Arată toate comenzile
                    </a>
                <% } else { %>
                    <h5 class="mb-2">Nu există încă nicio comandă plasată</h5>
                    <p class="manager-subtitle mb-0">
                        Comenzile trimise de clienți din pagina de checkout vor apărea automat aici.
                    </p>
                <% } %>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer', { fixedFooter: false }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const selectAll = document.getElementById('selectAllOrders');
            const checkboxes = Array.from(document.querySelectorAll('.order-checkbox:not(:disabled)'));
            const massBtns = Array.from(document.querySelectorAll('.mass-action-btn'));
            const countBadge = document.getElementById('selectedCountBadge');

            if (!selectAll) return;

            if (checkboxes.length === 0) {
                selectAll.disabled = true;
            }

            function syncMassActionUI() {
                const selectedCount = checkboxes.filter(cb => cb.checked).length;

                if (countBadge) {
                    countBadge.textContent = selectedCount === 1 ? '1 selectată' : `${selectedCount} selectate`;
                    countBadge.className = selectedCount > 0 ? 'badge bg-info text-dark' : 'badge bg-secondary';
                }

                massBtns.forEach(btn => {
                    btn.disabled = selectedCount === 0;
                });

                if (checkboxes.length > 0) {
                    selectAll.checked = selectedCount === checkboxes.length;
                    selectAll.indeterminate = selectedCount > 0 && selectedCount < checkboxes.length;
                }
            }

            selectAll.addEventListener('change', () => {
                checkboxes.forEach(cb => {
                    cb.checked = selectAll.checked;
                });
                syncMassActionUI();
            });

            checkboxes.forEach(cb => {
                cb.addEventListener('change', syncMassActionUI);
            });

            syncMassActionUI();
        })();
    </script>
</body>
</html>